# Copy this file to .env and adjust if needed. All values are optional;
# the server works out of the box without a .env file.

# Port the backend listens on.
PORT=4000

# Which network interface to bind to. 127.0.0.1 (the default) means only
# this machine can reach the API. Only set this to 0.0.0.0 if you deliberately
# want other devices on your network to reach it, and understand the API has
# no authentication.
HOST=127.0.0.1

# Comma-separated list of frontend origins allowed to call this API.
# Add an entry here if you serve the frontend from a different port or host.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Set to "production" to disable the /api/mock/seed test endpoint.
# Leave unset for local development and testing.
NODE_ENV=development
